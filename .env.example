# --- Обязательные параметры ---

# Токен бота от @BotFather
BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ключ OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# --- Доступ ---

# ID пользователей Telegram через запятую, которым разрешён бот.
# Если оставить пустым, ботом сможет пользоваться кто угодно (не рекомендуется: платит ваш ключ OpenAI).
ALLOWED_USER_IDS=

# --- Модели OpenAI ---

# whisper-1 (дёшево, есть таймкоды) или gpt-4o-transcribe / gpt-4o-mini-transcribe (точнее, без таймкодов)
TRANSCRIBE_MODEL=whisper-1

# Код языка ISO-639-1 для подсказки модели; пусто = автоопределение
TRANSCRIBE_LANGUAGE=ru

# Добавлять таймкоды в транскрипт (работает только с whisper-1)
TIMESTAMPS=false

# Модель для конспекта, ответов на вопросы и генерации теста (кнопки под расшифровкой)
SUMMARY_MODEL=gpt-4o-mini

# --- Лимиты и производительность ---

# Максимальная длительность видео в минутах
MAX_VIDEO_MINUTES=180

# Сколько видео обрабатывать одновременно
WORKERS=1

# Сколько чанков одного видео отправлять в OpenAI параллельно
TRANSCRIBE_CONCURRENCY=3

# --- Площадки ---

# Бот принимает ссылки на YouTube, Instagram, VK и TikTok.
# Cookies в формате Netscape нужны там, где площадка не отдаёт видео анонимно:
# YouTube — при "Sign in to confirm you're not a bot" (частая история на IP дата-центров),
# Instagram и VK — почти всегда, TikTok — обычно нет.

# Общий файл cookies: используется для площадки, у которой нет своего файла ниже.
COOKIES_FILE=

# Cookies отдельных площадок (перекрывают COOKIES_FILE)
YT_COOKIES_FILE=
INSTAGRAM_COOKIES_FILE=
VK_COOKIES_FILE=
TIKTOK_COOKIES_FILE=

# Прокси для yt-dlp, применяется ко всем площадкам.
# Например http://user:pass@host:port или socks5://host:1080
YT_PROXY=

# --- Файлы из Telegram ---

# Адрес локального telegram-bot-api, например http://localhost:8081
# Пусто = официальный Bot API, который отдаёт боту файлы только до 20 МБ.
TELEGRAM_API_URL=

# Максимальный размер присланного файла в МБ.
# По умолчанию 20 (лимит Bot API) или 2000, если задан TELEGRAM_API_URL.
MAX_FILE_MB=

# --- Скачивание видео (кнопка «Скачать видео» под превью) ---

# Максимальный размер файла, который бот отправляет обратно в чат, в МБ.
# По умолчанию 50 (лимит Bot API) или 2000, если задан TELEGRAM_API_URL.
MAX_UPLOAD_MB=

# Максимальная высота кадра при скачивании: 1080, 720, 480, 360.
# Чем меньше, тем выше шанс уложиться в лимит отправки.
MAX_DOWNLOAD_HEIGHT=720

# --- Режим группы (/group) ---

# Пауза в секундах после последней присланной записи, после которой появляется
# кнопка «Расшифровать в единый файл». Минимум 0.5.
GROUP_DEBOUNCE_SECONDS=4

# Сколько записей максимум можно собрать в одну группу
MAX_GROUP_ITEMS=50

# --- Прочее ---

LOG_LEVEL=INFO
DATA_DIR=data
